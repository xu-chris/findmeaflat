{
  "env": {
    "ENABLE_LSP_TOOL": "1",
    "CLAUDE_CODE_ENABLE_TELEMETRY": "0"
  },
  "permissions": {
    "allow": [
      "Bash(ls :*)",
      "Bash(gh issue :*)",
      "Bash(gh label list :*)",
      "Bash(gh pr view :*)",
      "Bash(ruby .agents/bin/check-proposal-board.rb)",
      "Bash(.agents/bin/check-harness.sh)",
      "mcp__tidewave__get_logs",
      "mcp__tidewave__execute_sql_query",
      "mcp__tidewave__get_ecto_schemas",
      "mcp__tidewave__get_docs",
      "mcp__tidewave__search_package_docs",
      "mcp__tidewave__get_source_location",
      "mcp__tidewave__project_eval"
    ],
    "deny": [
      "NotebookEdit",
      "DesignSync",
      "CronCreate",
      "CronDelete",
      "CronList",
      "ScheduleWakeup"
    ],
    "ask": []
  },
  "enableAllProjectMcpServers": true,
  "disableBundledSkills": true,
  "hooks": {
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "cat \"$(git rev-parse --show-toplevel)/AGENTS.md\""
          }
        ]
      },
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.agents/hooks/worktree-init.sh\"",
            "timeout": 600000
          }
        ]
      },
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.agents/hooks/cloud-container-setup.sh\"",
            "timeout": 120000
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.agents/hooks/protect-secrets.sh\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "prompt",
            "prompt": "The Elixir application lives at the repository root (mix.exs). If you edited any .ex, .exs, or .heex file, or anything under config/, priv/repo/migrations/ or priv/resource_snapshots/, run `mix ci` and report its exit code \u2014 it is the canonical gate and CI runs the same alias. Migrations are generated with `mix ash.codegen --name <name>`, never hand-edited. The database is stock postgres:18-alpine on port 5434 (`docker compose up -d`). If you edited none of those, respond with {\"ok\": true, \"reason\": \"No Elixir files edited\"}."
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "wt list statusline --format=claude-code"
  },
  "enabledPlugins": {}
}
